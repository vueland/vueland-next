{
  "name": "vueland",
  "version": "0.0.64",
  "author": "Anar Allakhverdiev",
  "license": "MIT",
  "private": false,
  "description": "VueLand Components Library",
  "main": "dist/vueland.common.cjs",
  "module": "dist/vueland.mjs",
  "styles": "dist/styles/vueland-base.css",
  "types": "types/index.d.ts",
  "typings": "types/index.d.ts",
  "sideEffects": [
    "*.sass",
    "*.scss",
    "*.css"
